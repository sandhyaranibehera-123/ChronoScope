# =============================================================================
# CHRONOSCOPE -- Environment Variables Example
# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed as living documentation.
# =============================================================================

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── MySQL (write side) ────────────────────────────────────────────────────────
# Primary relational store for the event log and command side.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=chronoscope_root_secret
MYSQL_DATABASE=chronoscope_core
MYSQL_USER=chronoscope_app
MYSQL_PASSWORD=chronoscope_app_secret
MYSQL_MIGRATOR_USER=chronoscope_migrator
MYSQL_MIGRATOR_PASSWORD=chronoscope_migrator_secret
DATABASE_URL=mysql://chronoscope_app:chronoscope_app_secret@localhost:3306/chronoscope_core

# ── MongoDB (read side -- profile-gated until Phase 4) ────────────────────────
# Document store for read-model projections. Not started by default.
# Start with: make infra-mongo
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_ROOT_USERNAME=chronoscope_mongo_root
MONGO_ROOT_PASSWORD=chronoscope_mongo_secret
MONGO_DATABASE=chronoscope_read
MONGO_URL=mongodb://chronoscope_query:chronoscope_query_secret@localhost:27017/chronoscope_read

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for distributed locks, idempotency keys, and ephemeral caches.
REDIS_URL=redis://localhost:6379

# ── Dev Auth (never use in production) ────────────────────────────────────────
# Enables simplified JWT auth for local development. Always false in prod.
DEV_AUTH_MODE=true
JWT_SECRET=chronoscope_dev_jwt_secret_change_in_prod
JWT_EXPIRY=8h

# ── Kafka (profile-gated until Phase 5) ───────────────────────────────────────
# Durable event bus for cross-service async integration.
# Start with: docker compose --profile kafka up -d
KAFKA_BROKERS=localhost:9092

# ── RabbitMQ (profile-gated until Phase 9) ────────────────────────────────────
# AMQP broker for fan-out and work-queue patterns.
# Start with: docker compose --profile rabbitmq up -d
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── NATS (profile-gated until Phase 10) ───────────────────────────────────────
# Lightweight pub/sub + JetStream for high-throughput scenarios.
# Start with: docker compose --profile nats up -d
NATS_URL=nats://localhost:4222

# ── MinIO (profile-gated) ─────────────────────────────────────────────────────
# S3-compatible object storage for snapshots and large payloads.
# Start with: docker compose --profile minio up -d
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=chronoscope_minio
MINIO_SECRET_KEY=chronoscope_minio_secret
