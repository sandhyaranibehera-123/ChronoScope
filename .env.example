# ==============================================================================
# CHRONOSCOPE — Environment Variables Configuration
# Copy this file to .env or paste directly into Render Environment Settings
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# MySQL — Authoritative Event Store & OCC (Source of Truth)
MYSQL_HOST=mysql-xxxxx.aivencloud.com
MYSQL_PORT=3306
MYSQL_DATABASE=chronoscope_core
MYSQL_USER=chronoscope_app
MYSQL_PASSWORD=<your-mysql-password>

# MongoDB — CQRS Read Store Projections
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chronoscope_read?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chronoscope_read?retryWrites=true&w=majority
MONGO_DATABASE=chronoscope_read

# Redis — Ephemeral Cache, Rate Limits & Heartbeats (Never for truth)
REDIS_URL=rediss://default:<password>@<redis-host>:6379

# Kafka — Event Streaming Backbone
KAFKA_BROKERS=assigned-broker:9092

# RabbitMQ — Asynchronous Jobs Queue
RABBITMQ_URL=amqps://<user>:<password>@<rabbitmq-host>/<vhost>

# NATS — Control Plane Transport
NATS_URL=nats://localhost:4222

# Security & Authentication
JWT_SECRET=chronoscope-production-super-secret-key-at-least-32-chars-long
JWT_EXPIRY=15m
DEV_AUTH_MODE=false

# Chaos Engine (Rule 21: Disabled by default in production)
CHAOS_MODE=false
