# CHRONOSCOPE MySQL server configuration.
#
# innodb_autoinc_lock_mode = 2 ("interleaved") is the single most
# load-bearing setting in this entire architecture: the timeline_position_seq
# allocator (system-guarantees.md rule 6) relies on AUTO_INCREMENT harvesting
# being a brief, non-blocking mutex rather than a lock held for the duration
# of the enclosing transaction. MySQL 8.4 already defaults to 2, but it is
# pinned explicitly here so the concurrency contract this whole design
# depends on is visible in source control and can't silently regress if a
# different image or managed-MySQL default is ever substituted.
[mysqld]
innodb_autoinc_lock_mode=2

# Small, explicit limits appropriate to an 8 GB development host — this
# project never wants a MySQL default quietly grabbing more than its share.
innodb_buffer_pool_size=256M
max_connections=50
